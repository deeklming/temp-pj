{
	"name": "temppj",
	"private": true,
	"type": "module",
	"workspaces": [
		"elysia",
		"react_router"
	],
	"scripts": {
		"setup": "bun run --cwd elysia setup",
		"dev": "bun run --parallel --filter 'temppj_*' dev",
		"test": "bun run build && bun test elysia/src shared react_router/tests",
		"typecheck": "bun run --cwd elysia typecheck && bun run --cwd react_router typecheck",
		"build": "bun run --cwd react_router build",
		"lint": "bunx biome check",
		"lint:w": "bunx biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3"
	},
	"engines": {
		"node": ">=22",
		"bun": ">=1.3.14"
	}
}
